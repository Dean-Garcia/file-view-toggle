{
  "name": "{{EXT_ID}}",
  "displayName": "{{EXT_ID}}",
  "description": "Allows user to select files and directories to toggle off and on in the explorer view",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onView:{{EXT_ID}}", "onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Hide Files",
      "properties": {
        "{{VIEW_ID}}.files": {
          "type": "object",
          "default": {},
          "description": "List of files to hide."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "{{EXT_ID}}",
          "name": "Hidden files"
        }
      ]
    },
    "submenus": [
      {
        "id": "{{VIEW_ID}}.submenu",
        "label": "Hide"
      },
      {
        "id": "{{VIEW_ID}}.submenu",
        "label": "Hide Extension"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "{{VIEW_ID}}.submenu",
          "group": "{{VIEW_ID}}"
        }
      ],
      "{{VIEW_ID}}.submenu": [
        {
          "command": "{{VIEW_ID}}.hide"
        },
        {
          "command": "{{VIEW_ID}}.hide-extension"
        }
      ],
      "view/title": [
        {
          "command": "{{VIEW_ID}}.refresh",
          "when": "view == {{EXT_ID}}",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "{{VIEW_ID}}.deleteItem",
          "when": "view == {{EXT_ID}}",
          "group": "inline"
        }
      ]
    },
    "commands": [
      {
        "command": "{{VIEW_ID}}.hide",
        "title": "Hide"
      },
      {
        "command": "{{VIEW_ID}}.hide-extension",
        "title": "Hide Extension"
      },
      {
        "command": "{{VIEW_ID}}.show",
        "title": "Show"
      },
      {
        "command": "{{VIEW_ID}}.refresh",
        "title": "Refresh",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "{{VIEW_ID}}.deleteItem",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "{{VIEW_ID}}.toggle-row-visibility",
        "title": "Toggle Row Visibility"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run build-manifest && yarn run package",
    "build-manifest": "node build-manifest.js",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
