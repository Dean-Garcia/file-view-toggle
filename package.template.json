{
  "name": "{{EXT_ID}}",
  "displayName": "Show/Hide Files, Directories, and Extensions",
  "description": "Allows user to select files and directories to toggle off and on in the explorer view",
  "version": "0.0.1",
  "publisher": "Dean-Garcia",
  "author": {
    "name": "Dean Garcia",
    "url": "https://github.com/Dean-Garcia"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": ["Visualization", "Other"],
  "keywords": [
    "exclude",
    "show",
    "explorer",
    "files",
    "hidden",
    "toggle",
    "hide",
    "filter"
  ],
  "activationEvents": ["onView:{{EXT_ID}}", "onStartupFinished"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dean-Garcia/file-view-toggle.git"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Hide Files",
      "properties": {
        "{{VIEW_ID}}.files": {
          "type": "object",
          "default": {},
          "description": "List of files to hide."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "{{EXT_ID}}",
          "name": "Hidden files"
        }
      ]
    },
    "submenus": [
      {
        "id": "{{VIEW_ID}}.submenu",
        "label": "Hide"
      },
      {
        "id": "{{VIEW_ID}}.submenu",
        "label": "Hide Extension"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "{{VIEW_ID}}.submenu",
          "group": "{{VIEW_ID}}"
        }
      ],
      "{{VIEW_ID}}.submenu": [
        {
          "command": "{{VIEW_ID}}.{{HIDE}}"
        },
        {
          "command": "{{VIEW_ID}}.{{HIDE_FILE_NAME}}"
        },
        {
          "command": "{{VIEW_ID}}.{{HIDE_FILE_EXTENSION}}"
        }
      ],
      "view/title": [
        {
          "command": "{{VIEW_ID}}.{{SHOW_ALL}}",
          "when": "view == {{EXT_ID}}",
          "group": "navigation@1"
        },
        {
          "command": "{{VIEW_ID}}.{{HIDE_ALL}}",
          "when": "view == {{EXT_ID}}",
          "group": "navigation@2"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_SELECTED}}",
          "when": "view == {{EXT_ID}}",
          "group": "navigation@3"
        },
        {
          "command": "{{VIEW_ID}}.{{REFRESH}}",
          "when": "view == {{EXT_ID}}",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_FAVORITE_ON}}",
          "when": "view == {{EXT_ID}} && viewItem =~ /-favorite-/",
          "group": "inline@1"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_FAVORITE_OFF}}",
          "when": "view == {{EXT_ID}} && viewItem =~ /-notFavorite-/",
          "group": "inline@1"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_SEARCH_ON}}",
          "when": "view == {{EXT_ID}} && viewItem =~ /-searchable-/",
          "group": "inline@2"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_SEARCH_OFF}}",
          "when": "view == {{EXT_ID}} && viewItem =~ /-notSearchable-/",
          "group": "inline@2"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_LOCK_ON}}",
          "when": "view == {{EXT_ID}} && viewItem =~ /-locked/",
          "group": "inline@3"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_LOCK_OFF}}",
          "when": "view == {{EXT_ID}} && viewItem =~ /-unlocked/",
          "group": "inline@3"
        },
        {
          "command": "{{VIEW_ID}}.{{REMOVE}}",
          "when": "view == {{EXT_ID}} && viewItem =~ /viewableItem-/",
          "group": "inline@4"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_SEARCH_ON}}",
          "when": "view == {{EXT_ID}} && viewItem == folderNode",
          "group": "1_modification@1"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_SEARCH_OFF}}",
          "when": "view == {{EXT_ID}} && viewItem == folderNode",
          "group": "1_modification@2"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_HIDE}}",
          "when": "view == {{EXT_ID}} && viewItem == folderNode",
          "group": "1_modification@3"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_SHOW}}",
          "when": "view == {{EXT_ID}} && viewItem == folderNode",
          "group": "1_modification@4"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_LOCK}}",
          "when": "view == {{EXT_ID}} && viewItem == folderNode",
          "group": "1_modification@5"
        },
        {
          "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_UNLOCK}}",
          "when": "view == {{EXT_ID}} && viewItem == folderNode",
          "group": "1_modification@6"
        }
      ]
    },
    "commands": [
      {
        "command": "{{VIEW_ID}}.{{HIDE}}",
        "title": "Hide File"
      },
      {
        "command": "{{VIEW_ID}}.{{HIDE_FILE_NAME}}",
        "title": "Hide Files Sharing Name"
      },
      {
        "command": "{{VIEW_ID}}.{{HIDE_FILE_EXTENSION}}",
        "title": "Hide File Extension"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_SEARCH_ON}}",
        "title": "Currently allows search, go to reference, etc. on this file. Click to disable",
        "icon": "$(search)"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_SEARCH_OFF}}",
        "title": "Currently removed from search results and prevents go to reference and similar features.  Click to add to search",
        "icon": "$(search-stop)"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_FAVORITE_ON}}",
        "title": "Move out of favorites",
        "icon": "$(heart-filled)"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_FAVORITE_OFF}}",
        "title": "Move to favorites folder",
        "icon": "$(heart)"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_LOCK_ON}}",
        "title": "Locked. Prevents search/visibility setting changes. Click to unlock.",
        "icon": "$(lock)"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_LOCK_OFF}}",
        "title": "Click to lock and prevent search/visibility setting changes",
        "icon": "$(unlock)"
      },
      {
        "command": "{{VIEW_ID}}.{{REMOVE}}",
        "title": "Remove file from list",
        "icon": "$(trash)"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_ROW_VISIBILITY}}",
        "title": "Toggle File Visibility",
        "icon": "$(eye)"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_SELECTED}}",
        "title": "Toggle Visibility of Active Selection",
        "icon": "$(activate-breakpoints)"
      },
      {
        "command": "{{VIEW_ID}}.{{HIDE_ALL}}",
        "title": "Hide All Files from Explorer",
        "icon": "$(eye-closed)"
      },
      {
        "command": "{{VIEW_ID}}.{{SHOW_ALL}}",
        "title": "Show All Files in Explorer",
        "icon": "$(eye)"
      },
      {
        "command": "{{VIEW_ID}}.{{REFRESH}}",
        "title": "Refresh View",
        "icon": "$(refresh)"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_SEARCH_ON}}",
        "title": "Search on"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_SEARCH_OFF}}",
        "title": "Search off"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_HIDE}}",
        "title": "HIDE"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_SHOW}}",
        "title": "SHOW"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_LOCK}}",
        "title": "LOCK"
      },
      {
        "command": "{{VIEW_ID}}.{{TOGGLE_FOLDER_UNLOCK}}",
        "title": "UNLOCK"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run build-manifest && yarn run package",
    "build-manifest": "node build-manifest.js",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
