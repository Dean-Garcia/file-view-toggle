{
  "name": "file-view-toggle",
  "displayName": "file-view-toggle",
  "description": "Allows user to select files and directories to toggle off and on in the explorer view",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:file-view-toggle",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Hide Files",
      "properties": {
        "file-visibility.files": {
          "type": "object",
          "default": {},
          "description": "List of files to hide."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "file-view-toggle",
          "name": "Hidden files"
        }
      ]
    },
    "submenus": [
      {
        "id": "file-visibility.submenu",
        "label": "Hide"
      },
      {
        "id": "file-visibility.submenu",
        "label": "Hide Extension"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "file-visibility.submenu",
          "group": "file-visibility"
        }
      ],
      "file-visibility.submenu": [
        {
          "command": "file-visibility.hide"
        },
        {
          "command": "file-visibility.hide-extension"
        }
      ],
      "view/title": [
        {
          "command": "file-visibility.refresh",
          "when": "view == file-view-toggle",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "file-visibility.deleteItem",
          "when": "view == file-view-toggle",
          "group": "inline"
        }
      ]
    },
    "commands": [
      {
        "command": "file-visibility.hide",
        "title": "Hide"
      },
      {
        "command": "file-visibility.hide-extension",
        "title": "Hide Extension"
      },
      {
        "command": "file-visibility.show",
        "title": "Show"
      },
      {
        "command": "file-visibility.refresh",
        "title": "Refresh",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "file-visibility.deleteItem",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "file-visibility.toggle-row-visibility",
        "title": "Toggle Row Visibility"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
