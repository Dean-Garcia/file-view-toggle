{
  "name": "file-view-toggle",
  "displayName": "Show/Hide Files, Directories, and Extensions",
  "description": "Allows user to select files and directories to toggle off and on in the explorer view",
  "version": "0.0.1",
  "publisher": "Dean-Garcia",
  "author": {
    "name": "Dean Garcia",
    "url": "https://github.com/Dean-Garcia"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": ["Visualization", "Other"],
  "keywords": [
    "exclude",
    "show",
    "explorer",
    "files",
    "hidden",
    "toggle",
    "hide",
    "filter"
  ],
  "activationEvents": ["onView:file-view-toggle", "onStartupFinished"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dean-Garcia/file-view-toggle.git"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Hide Files",
      "properties": {
        "file-visibility.files": {
          "type": "object",
          "default": {},
          "description": "List of files to hide."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "file-view-toggle",
          "name": "Hidden files"
        }
      ]
    },
    "submenus": [
      {
        "id": "file-visibility.submenu",
        "label": "Hide"
      },
      {
        "id": "file-visibility.submenu",
        "label": "Hide Extension"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "file-visibility.submenu",
          "group": "file-visibility"
        }
      ],
      "file-visibility.submenu": [
        {
          "command": "file-visibility.hide"
        },
        {
          "command": "file-visibility.hide-file-name"
        },
        {
          "command": "file-visibility.hide-file-extension"
        }
      ],
      "view/title": [
        {
          "command": "file-visibility.show-all",
          "when": "view == file-view-toggle",
          "group": "navigation@1"
        },
        {
          "command": "file-visibility.hide-all",
          "when": "view == file-view-toggle",
          "group": "navigation@2"
        },
        {
          "command": "file-visibility.hide-selected",
          "when": "view == file-view-toggle",
          "group": "navigation@3"
        },
        {
          "command": "file-visibility.refresh",
          "when": "view == file-view-toggle",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "file-visibility.toggle-favorite-on",
          "when": "view == file-view-toggle && viewItem =~ /-favorite-/",
          "group": "inline@1"
        },
        {
          "command": "file-visibility.toggle-favorite-off",
          "when": "view == file-view-toggle && viewItem =~ /-notFavorite-/",
          "group": "inline@1"
        },
        {
          "command": "file-visibility.toggle-search-on",
          "when": "view == file-view-toggle && viewItem =~ /-searchable-/",
          "group": "inline@2"
        },
        {
          "command": "file-visibility.toggle-search-off",
          "when": "view == file-view-toggle && viewItem =~ /-notSearchable-/",
          "group": "inline@2"
        },
        {
          "command": "file-visibility.toggle-lock-on",
          "when": "view == file-view-toggle && viewItem =~ /-locked/",
          "group": "inline@3"
        },
        {
          "command": "file-visibility.toggle-lock-off",
          "when": "view == file-view-toggle && viewItem =~ /-unlocked/",
          "group": "inline@3"
        },
        {
          "command": "file-visibility.remove",
          "when": "view == file-view-toggle && viewItem =~ /viewableItem-/",
          "group": "inline@4"
        },
        {
          "command": "file-visibility.toggle-folder-search-on",
          "when": "view == file-view-toggle && viewItem == folderNode",
          "group": "1_modification@1"
        },
        {
          "command": "file-visibility.toggle-folder-search-off",
          "when": "view == file-view-toggle && viewItem == folderNode",
          "group": "1_modification@2"
        },
        {
          "command": "file-visibility.toggle-folder-hide",
          "when": "view == file-view-toggle && viewItem == folderNode",
          "group": "1_modification@3"
        },
        {
          "command": "file-visibility.toggle-folder-show",
          "when": "view == file-view-toggle && viewItem == folderNode",
          "group": "1_modification@4"
        },
        {
          "command": "file-visibility.toggle-folder-lock-on",
          "when": "view == file-view-toggle && viewItem == folderNode",
          "group": "1_modification@5"
        },
        {
          "command": "file-visibility.toggle-folder-lock-off",
          "when": "view == file-view-toggle && viewItem == folderNode",
          "group": "1_modification@6"
        }
      ]
    },
    "commands": [
      {
        "command": "file-visibility.hide",
        "title": "Hide File"
      },
      {
        "command": "file-visibility.hide-file-name",
        "title": "Hide Files Sharing Name"
      },
      {
        "command": "file-visibility.hide-file-extension",
        "title": "Hide File Extension"
      },
      {
        "command": "file-visibility.toggle-search-on",
        "title": "Currently allows search, go to reference, etc. on this file. Click to disable",
        "icon": "$(search)"
      },
      {
        "command": "file-visibility.toggle-search-off",
        "title": "Currently removed from search results and prevents go to reference and similar features.  Click to add to search",
        "icon": "$(search-stop)"
      },
      {
        "command": "file-visibility.toggle-favorite-on",
        "title": "Move out of favorites",
        "icon": "$(heart-filled)"
      },
      {
        "command": "file-visibility.toggle-favorite-off",
        "title": "Move to favorites folder",
        "icon": "$(heart)"
      },
      {
        "command": "file-visibility.toggle-lock-on",
        "title": "Locked. Prevents search/visibility setting changes. Click to unlock.",
        "icon": "$(lock)"
      },
      {
        "command": "file-visibility.toggle-lock-off",
        "title": "Click to lock and prevent search/visibility setting changes",
        "icon": "$(unlock)"
      },
      {
        "command": "file-visibility.remove",
        "title": "Remove file from list",
        "icon": "$(trash)"
      },
      {
        "command": "file-visibility.toggle-row-visibility",
        "title": "Toggle File Visibility",
        "icon": "$(eye)"
      },
      {
        "command": "file-visibility.hide-selected",
        "title": "Toggle Visibility of Active Selection",
        "icon": "$(activate-breakpoints)"
      },
      {
        "command": "file-visibility.hide-all",
        "title": "Hide All Files from Explorer",
        "icon": "$(eye-closed)"
      },
      {
        "command": "file-visibility.show-all",
        "title": "Show All Files in Explorer",
        "icon": "$(eye)"
      },
      {
        "command": "file-visibility.refresh",
        "title": "Refresh View",
        "icon": "$(refresh)"
      },
      {
        "command": "file-visibility.toggle-folder-search-on",
        "title": "Search on"
      },
      {
        "command": "file-visibility.toggle-folder-search-off",
        "title": "Search off"
      },
      {
        "command": "file-visibility.toggle-folder-hide",
        "title": "HIDE"
      },
      {
        "command": "file-visibility.toggle-folder-show",
        "title": "SHOW"
      },
      {
        "command": "file-visibility.toggle-folder-lock-on",
        "title": "LOCK"
      },
      {
        "command": "file-visibility.toggle-folder-lock-off",
        "title": "UNLOCK"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run build-manifest && yarn run package",
    "build-manifest": "node build-manifest.js",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
